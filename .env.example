# ─── Canonical URL ───────────────────────────────────────────────────────────
# Set to the live domain. Drives canonical tags, sitemap.xml and Open Graph.
NEXT_PUBLIC_SITE_URL="https://www.rdprimeindia.com"

# ─── Contact details not published by the company ────────────────────────────
# Leave BLANK until confirmed. The site omits whatever is unset rather than
# showing a guessed address or number. See docs/VERIFIED-COMPANY-FACTS.md §2.
NEXT_PUBLIC_COMPANY_EMAIL=""
NEXT_PUBLIC_COMPANY_WHATSAPP=""   # digits only with country code, e.g. 919876543210

# ─── Enquiry delivery (REQUIRED — forms return 503 without one of these) ─────
# Option A: Resend (https://resend.com) — verify the sending domain first.
RESEND_API_KEY=""
ENQUIRY_FROM_EMAIL="enquiries@rdprimeindia.com"
ENQUIRY_TO_EMAIL="sales@rdprimeindia.com"   # comma-separate for several recipients

# Option B: post to a CRM / automation endpoint instead of sending email.
ENQUIRY_WEBHOOK_URL=""
ENQUIRY_WEBHOOK_TOKEN=""
